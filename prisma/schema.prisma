datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Cuenta de administrador del panel (/admin). Login por correo + contraseña
// (hash con bcrypt, nunca texto plano) vía NextAuth Credentials.
model AdminUser {
  id                String       @id @default(cuid())
  email             String       @unique
  passwordHash      String
  name              String?
  createdAt         DateTime     @default(now())
  // Las sesiones iniciadas antes de esta fecha dejan de valer (se actualiza
  // al cambiar la contraseña, para cerrar cualquier sesión ajena abierta).
  passwordChangedAt DateTime?
  comentarios       Comentario[]
}

// Un registro por intento (inicio de sesión fallido, envío de formulario…)
// para limitar la frecuencia por IP/correo. La clave no guarda el correo en
// claro, solo su huella. Se purga solo (ver lib/rate-limit.ts).
model LimiteTasa {
  id        String   @id @default(cuid())
  clave     String
  createdAt DateTime @default(now())

  @@index([clave, createdAt])
}

// Comentario interno de un administrador sobre una postulación (para
// coordinar el proceso de selección entre varias personas del equipo).
model Comentario {
  id            String      @id @default(cuid())
  texto         String
  createdAt     DateTime    @default(now())
  postulacion   Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  postulacionId String
  admin         AdminUser   @relation(fields: [adminId], references: [id])
  adminId       String
}

enum ModalidadTrabajo {
  REMOTO
  PRESENCIAL
  HIBRIDO
}

// Estado del proceso de selección, para que el panel admin pueda filtrar
// por etapa en vez de tener que leer comentarios para saber en qué va cada
// postulación.
enum EstadoPostulacion {
  NUEVA
  EN_REVISION
  ENTREVISTA
  RECHAZADA
  CONTRATADA
}

// Qué tanto interesa la persona a la empresa. Es independiente del estado:
// permite marcar rápido a quién mirar primero o a quién descartar, sin
// depender de en qué etapa del proceso va.
enum InteresPostulacion {
  SIN_VALORAR
  POSIBLE_BUEN_CANDIDATO
  CON_INTERES
  DESCARTADO
}

// Una postulación enviada desde /talento. Las respuestas de opinión van en
// columnas separadas (String) en vez de un solo Json: son pocas preguntas
// fijas y así se pueden filtrar/exportar directo por SQL si el equipo lo
// necesita más adelante. Los campos nuevos de sí/no y la modalidad sí usan
// tipos estrictos (Boolean / enum) porque son los que tiene sentido filtrar
// en el panel.
model Postulacion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Contacto
  nombre    String
  correo    String
  telefono  String?
  // Dónde vive la persona. Opcional en la base de datos porque las
  // postulaciones anteriores a este campo no la tienen; el formulario sí la pide.
  direccion String?

  // Preguntas de entrevista (reformuladas, mismo fondo que el cuestionario original)
  opinionSociedad                   String
  opinionPoblacionMaya              String
  comodidadTrabajarConPoblacionMaya String
  opinionFormaPensarActuarMaya      String
  opinionCulturaMaya                String
  opinionCosmovisionMaya            String
  disposicionCeremoniaMaya          String
  disponibilidadTiempo              String
  disponibilidadHorario             String
  diaNoDisponible                   String?
  trabajoBajoPresion                String
  porQueEstaOrganizacion            String
  etapaCarrera                      String
  porQueContratarlo                 String
  expectativaSalarial               String

  // Preguntas nuevas
  modalidadTrabajo   ModalidadTrabajo
  puedeFacturar      Boolean
  tieneVehiculo      Boolean
  esEstudianteActual Boolean
  trabajaActualmente Boolean

  // Archivos (keys de Netlify Blobs, no el archivo en sí)
  cvBlobKey        String
  documentoBlobKey String?

  // Posición a la que aplica. vacanteTitulo guarda el nombre tal como se veía
  // al postular, para que el historial no cambie si la vacante se renombra.
  // Null en ambos = postulación general (o anterior a que existieran vacantes).
  vacante       Vacante? @relation(fields: [vacanteId], references: [id], onDelete: SetNull)
  vacanteId     String?
  vacanteTitulo String?

  // Resumen del cuestionario generado con IA (sugerencia para el equipo, no
  // una evaluación). Null si la IA no está configurada o aún no se generó.
  resumenIA   String?
  resumenIAAt DateTime?

  estado      EstadoPostulacion  @default(NUEVA)
  // Valoración de la empresa sobre la persona, aparte del estado del proceso.
  interes     InteresPostulacion @default(SIN_VALORAR)
  comentarios Comentario[]

  // Agenda de entrevista: el token va en el enlace que recibe la persona
  // (/entrevista/<token>), así no necesita cuenta. entrevistaInvitadaAt es la
  // última vez que se le envió la invitación por correo.
  entrevistaToken      String?            @unique
  entrevistaInvitadaAt DateTime?
  entrevistas          FranjaEntrevista[]

  @@index([vacanteId])
}

// Un horario de entrevista que el equipo habilita. Sin postulación = libre.
// Si se borra la postulación, el horario vuelve a quedar libre.
model FranjaEntrevista {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  inicio  DateTime
  fin     DateTime
  // Enlace de videollamada o lugar; se le muestra a quien reserva.
  detalle String?

  postulacion   Postulacion? @relation(fields: [postulacionId], references: [id], onDelete: SetNull)
  postulacionId String?
  reservadaAt   DateTime?

  @@index([inicio])
  @@index([postulacionId])
}

// Plaza abierta que se muestra en /vacantes y en la lista de /talento. El
// equipo las crea, edita, habilita o deshabilita desde el panel admin.
// funciones y requisitos son listas cortas (una viñeta por elemento).
model Vacante {
  id            String        @id @default(cuid())
  titulo        String
  resumen       String
  modalidad     String
  funciones     String[]
  requisitos    String[]
  activa        Boolean       @default(true)
  orden         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  postulaciones Postulacion[]
}

// Ajustes editables desde el panel (correos que reciben avisos de contacto
// y de postulaciones), con la variable de entorno como respaldo si aún no
// se ha guardado nada aquí. Mismo patrón que el sitio de PyGuate.
model Setting {
  key   String @id
  value String
}
